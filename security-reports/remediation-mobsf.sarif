            {
              "id": "android_task_hijacking2",
              "help": {
                "text": "Activity is found to be vulnerable to StrandHogg 2.0 task hijacking vulnerability. When vulnerable, it is possible for other applications to place a malicious activity on top of the activity stack of the vulnerable application. This makes the application an easy target for phishing attacks. The vulnerability can be remediated by setting the launch mode attribute to \"singleInstance\" and by setting an empty taskAffinity (taskAffinity=\"\"). You can also update the target SDK version (26) of the app to 29 or higher to fix this issue at platform level.\n\nReference: https://github.com/OWASP/owasp-mastg/blob/master/Document/0x05a-Platform-Overview.md"
              },
              "name": "Activity is found to be vulnerable to StrandHogg 2.0 task hijacking vulnerability (CWE-1021)",
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-1021",
                  "owasp-mobile/m1",
                  "masvs/platform-1"
                ],
                "precision": "high",
                "security-severity": "9.0",
                "problem.severity": "error"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Activity is found to be vulnerable to StrandHogg 2.0 task hijacking vulnerability. When vulnerable, it is possible for other applications to place a malicious activity on top of the activity stack of the vulnerable application. This makes the application an easy target for phishing attacks. The vulnerability can be remediated by setting the launch mode attribute to \"singleInstance\" and by setting an empty taskAffinity (taskAffinity=\"\"). You can also update the target SDK version (26) of the app to 29 or higher to fix this issue at platform level."
              },
              "helpUri": "https://github.com/OWASP/owasp-mastg/blob/master/Document/0x05a-Platform-Overview.md",
              "shortDescription": {
                "text": "Activity is found to be vulnerable to StrandHogg 2.0 task hijacking vulnerability (CWE-1021)"
              }
            },
