            {
              "id": "android_kotlin_rsa_no_oaep",
              "help": {
                "text": "This App uses RSA Crypto without OAEP padding. The purpose of the padding scheme is to prevent a number of attacks on RSA that only work when the encryption is performed without padding.\n\nReference: https://github.com/MobSF/owasp-mstg/blob/master/Document/0x04g-Testing-Cryptography.md#mobile-app-cryptography"
              },
              "name": "This App uses RSA Crypto without OAEP padding (CWE-780)",
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-780",
                  "owasp-mobile/m5",
                  "masvs/crypto-3"
                ],
                "precision": "high",
                "security-severity": "9.0",
                "problem.severity": "error"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "This App uses RSA Crypto without OAEP padding. The purpose of the padding scheme is to prevent a number of attacks on RSA that only work when the encryption is performed without padding."
              },
              "helpUri": "https://github.com/MobSF/owasp-mstg/blob/master/Document/0x04g-Testing-Cryptography.md#mobile-app-cryptography",
              "shortDescription": {
                "text": "This App uses RSA Crypto without OAEP padding (CWE-780)"
              }
            },
            {
              "id": "android_kotlin_pending_intent_not_immutable",
              "help": {
                "text": "PendingIntent is created without FLAG_IMMUTABLE. Prior to API 31, PendingIntents are mutable by default; a malicious app may amend the wrapped Intent (action, data, flags), especially when the base Intent is implicit. Always specify FLAG_IMMUTABLE unless mutability is required.\n\nReference: https://developer.android.com/reference/android/app/PendingIntent#FLAG_IMMUTABLE"
              },
              "name": "PendingIntent is created without FLAG_IMMUTABLE (CWE-926)",
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-926",
                  "owasp-mobile/m1",
                  "masvs/platform-4"
                ],
                "precision": "medium",
                "security-severity": "2.0",
                "problem.severity": "note"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "PendingIntent is created without FLAG_IMMUTABLE. Prior to API 31, PendingIntents are mutable by default; a malicious app may amend the wrapped Intent (action, data, flags), especially when the base Intent is implicit. Always specify FLAG_IMMUTABLE unless mutability is required."
              },
              "helpUri": "https://developer.android.com/reference/android/app/PendingIntent#FLAG_IMMUTABLE",
              "shortDescription": {
                "text": "PendingIntent is created without FLAG_IMMUTABLE (CWE-926)"
              }
            },
            {
              "id": "android_kotlin_intent_redirection",
              "help": {
                "text": "An Intent received via getParcelableExtra or Intent.parseUri is re-dispatched. If the component is exported, a malicious app can supply an embedded Intent and escalate privileges (intent redirection).\n\nReference: https://mas.owasp.org/MASTG/Android/0x05h-Testing-Platform-Interaction/"
              },
              "name": "An Intent received via getParcelableExtra or Intent.parseUri is re-dispatched (CWE-926)",
